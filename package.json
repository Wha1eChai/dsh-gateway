{
  "name": "@wha1echai/dsh-gateway-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "corepack pnpm@11.7.0 -r --if-present --sort run build",
    "typecheck": "corepack pnpm@11.7.0 -r --if-present --sort run typecheck",
    "lint": "node scripts/verify-repository.mjs lint",
    "test:unit": "corepack pnpm@11.7.0 --filter @dsh-gateway/fake-cpa test && vitest run --config vitest.config.ts",
    "test:integration": "node scripts/verify-phase3.mjs && node scripts/verify-real-cpa.mjs",
    "test:analytics": "vitest run packages/analytics/src --config vitest.config.ts && corepack pnpm@11.7.0 --filter @wha1echai/dsh-gateway-analytics run build && node scripts/verify-analytics.mjs",
    "test:browser": "node scripts/phase6-browser.mjs",
    "test:hmr": "node scripts/phase6-hmr.mjs",
    "test:public-api": "node scripts/verify-public-api.mjs && tsc -p tests/public-api/tsconfig.json --noEmit",
    "test:supply-chain": "node scripts/verify-repository.mjs supply-chain",
    "test:clean-checkout": "node scripts/verify-clean-checkout.mjs",
    "test:llm-compat": "node scripts/verify-llm-compat.mjs",
    "test:oauth": "vitest run packages/gateway/src/host/oauth/oauth.test.ts --config vitest.config.ts",
    "test:quota": "vitest run packages/gateway/src/host/cpa-client/cpa-client.test.ts packages/analytics/src/pipeline/pipeline.test.ts packages/analytics/src/service.test.ts --config vitest.config.ts",
    "test:security": "node scripts/verify-security.mjs",
    "pack:build": "node scripts/release/build-release.mjs",
    "pack:verify": "node scripts/verify-pack.mjs",
    "verify": "node scripts/verify-all.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-modules": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-web-react": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings-file": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-generator": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "22.20.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vitest/coverage-v8": "4.1.8",
    "echarts": "6.1.0",
    "lightningcss": "1.32.0",
    "playwright": "1.61.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "zod": "4.4.3"
  }
}
