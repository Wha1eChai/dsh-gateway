{
  "name": "@dshapps/dsh-gateway-analytics",
  "description": "Privacy-bounded SQLite analytics for dsh-gateway",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/engine-*.js",
    "lib/storage/worker-entry.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wha1eChai/dsh-gateway.git",
    "directory": "packages/analytics"
  },
  "dependencies": {
    "@dshapps/dsh-gateway": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && node ../../scripts/clean-analytics-build.mjs && tsdown",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run src --config ../../vitest.config.ts"
  }
}
