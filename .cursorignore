# Keep Cursor from packing caches, deps, and sibling trees.
# This parent folder is not a git repo; without this file Cursor
# snapshots the entire 4+ GB tree onto the C: drive.

**/node_modules/
**/.cache/
**/.staging/
**/.tmp/
**/.worktrees/
**/coverage/
**/dist/
**/build/
**/out/
**/*.tsbuildinfo

deepseek-harness/
.worktrees/
output/
research/

**/*.tgz
**/*.zip
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
**/darwin-arm64/
**/darwin-x64/
**/linux-arm64/
**/linux-x64/
**/win32-arm64/
**/win32-x64/
